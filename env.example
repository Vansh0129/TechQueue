# TechQueue Interview Coach - Environment Configuration
# =====================================================
# dev_server.py runs fully offline using Ollama (no API keys required).
# Make sure Ollama is installed and running: https://ollama.com
#
# Rename this file to .env before running the server:
#   copy env.example .env
#
# Then run:  python dev_server.py
# Open:      http://localhost:8181

# Ollama endpoint (default: local Ollama on port 11434)
OLLAMA_URL=http://localhost:11434/api/chat

# Ollama model to use (granite3-moe:3b)
OLLAMA_MODEL=granite3-moe:3b

# Port for the dev UI
PORT=8181
