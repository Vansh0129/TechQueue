    "parse_candidate_profile": {
      "spec": {
        "kind": "tool",
        "name": "parse_candidate_profile",
        "display_name": "parse_candidate_profile",
        "description": "Parse and enrich the raw candidate input into a structured prep context.\n\nDerives focus areas and recommended question types based on the job role\nand experience level, producing a clean context object for LLM prompt nodes.",
        "input_schema": {
          "$ref": "#/schemas/parse_candidate_profile_input"
        },
        "output_schema": {
          "$ref": "#/schemas/PrepInput"
        },
        "tool": "parse_candidate_profile"
      }
